# --- event tree (from Step 2's last diagram) ---

# Top-level event
wearBW::a Patrick wears black then wears white ::e

# Mid-level sub-events - leads-to chain, each part-of the top
wearB::a Patrick wears black t-shirt ::e
  --> swapT::a Patrick swaps t-shirt ::e
  --> wearW::a Patrick wears white t-shirt ::e

wearB --::P--> wearBW
swapT --::P--> wearBW
wearW --::P--> wearBW

# Inner sub-events - the swap itself decomposes into a finer chain
takeOff::a Take off black ::e       --::P--> swapT
halfNaked::a Patrick half-naked ::e --::P--> swapT
takeOn::a Take on white ::e         --::P--> swapT

takeOff --> halfNaked --> takeOn

# --- things (from Step 2) ---

# Patrick is present throughout - attach at the top, and he is in
# every sub-event.
Patrick --> wearBW

# T-shirts only in the sub-events where each one actually is
black t-shirt --> wearB, takeOff
white t-shirt --> wearW, takeOn

# --- concepts (from Step 3) ---

Patrick --> human ::c
swapT --> swap of clothing ::c
